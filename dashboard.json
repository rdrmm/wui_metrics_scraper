{
  "dashboard": {
    "annotations": { "list": [] },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "links": [],
    "liveNow": false,
    "panels": [
      {
        "title": "Current Active Clients",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [{ "expr": "router_clients_active_total", "refId": "A" }],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 15 },
                { "color": "red", "value": 25 }
              ]
            }
          }
        }
      },
      {
        "title": "WAN Throughput (Mbps)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
        "targets": [
          {
            "expr": "irate(router_network_bytes_total{interface=\"Broadband Connection (Ethernet/Coax)\", direction=\"rx\"}[2m]) * 8 / 1000 / 1000",
            "legendFormat": "Download",
            "refId": "A"
          },
          {
            "expr": "irate(router_network_bytes_total{interface=\"Broadband Connection (Ethernet/Coax)\", direction=\"tx\"}[2m]) * 8 / 1000 / 1000",
            "legendFormat": "Upload",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "bps" }
        }
      },
      {
        "title": "Wi-Fi Errors (Packet Drops)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "irate(router_network_errors_total{interface=~\".*Wireless.*\"}[5m])",
            "legendFormat": "{{interface}} Errors",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": { "custom": { "drawStyle": "bars" } }
        }
      },
      {
        "title": "WiFi Channel Usage",
        "type": "table",
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "router_wifi_channel",
            "legendFormat": "{{interface}} ({{band}})",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "displayMode": "color-text"
            }
          }
        }
      },
      {
        "title": "WiFi Noise Floor & SNR",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "router_wifi_noise_floor",
            "legendFormat": "{{interface}} Noise Floor",
            "refId": "A"
          },
          {
            "expr": "router_wifi_snr",
            "legendFormat": "{{interface}} SNR",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "dBm" }
        }
      },
      {
        "title": "Clients per WiFi Band",
        "type": "bargauge",
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 22 },
        "targets": [
          {
            "expr": "router_wifi_clients_per_band",
            "legendFormat": "{{band}}",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Device Connection Rates",
        "type": "table",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
        "targets": [
          {
            "expr": "router_device_connection_rate > 0",
            "legendFormat": "{{name}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "Mbps" }
        }
      },
      {
        "title": "Connected Devices by Band",
        "type": "table",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
        "targets": [
          {
            "expr": "router_device_online{ssid!=\"Wired\"}",
            "legendFormat": "{{name}} ({{ssid}})",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "displayMode": "color-text"
            }
          }
        }
      }
    ],
    "refresh": "10s",
    "schemaVersion": 36,
    "style": "dark",
    "tags": ["router", "network"],
    "timezone": "",
    "title": "Router Performance Dashboard",
    "uid": "router_perf_01",
    "version": 1
  }
}